# Local use can leave API_KEY empty. Set a long random value before internet-facing use.
API_KEY=

# Upload and media resource limits
API_MAX_UPLOAD_BYTES=10485760
API_MAX_VIDEO_UPLOAD_BYTES=262144000
API_MAX_IMAGE_PIXELS=25000000
API_MAX_VIDEO_PIXELS=8294400
API_MAX_VIDEO_DURATION_SECONDS=600

# Abuse and workload protection
API_RATE_LIMIT_REQUESTS=240
API_RATE_LIMIT_WINDOW_SECONDS=60
API_MAX_ACTIVE_VIDEO_JOBS=3

# Temporary result cleanup
API_VIDEO_JOB_TTL_SECONDS=3600
API_VIDEO_JOB_CLEANUP_INTERVAL_SECONDS=60

